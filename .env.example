# Copy to .env and fill in what you need. .env is gitignored -- never commit it.
#
# Everything here is optional: deploy.sh defaults every value below, so a missing
# .env means a normal deploy, not a deploy to somewhere unintended.
#
#   cp .env.example .env

# --- Public. Compiled into the JavaScript bundle. ---------------------------
#
# create-react-app inlines every REACT_APP_* variable into the built JS, which is
# then served from the CDN. NEVER put a secret behind that prefix -- deploy.sh
# greps the build for the deploy-time secrets below and refuses to upload if one
# of them turns up, but the prefix rule is what keeps that check from mattering.
#
# A Firebase web API key is public by design; what protects it is the HTTP
# referrer restriction on the key itself, not secrecy. Ask an admin for one.
REACT_APP_FIREBASE_API_KEY=

# --- Deploy-time only. Read by deploy.sh, never reaches the bundle. ----------
#
# These are the defaults deploy.sh already uses; set them only to deploy a fork
# somewhere else. They are not secrets -- the buckets and the distribution are
# named in the deploy script in git.
AWS_REGION=us-east-2
BETA_BUCKET=beta.electrifygame.com
PROD_BUCKET=electrifygame.com
PROD_DISTRIBUTION_ID=E38D57AILAHD00

# AWS credentials do NOT belong here. Use `aws configure` (which stores them in
# ~/.aws, outside the repo) locally, and the deploy workflow's federated role in
# CI. deploy.sh reads whichever the AWS CLI finds.
