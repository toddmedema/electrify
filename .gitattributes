# Normalise text files to LF in the index and the working tree, so that prettier's
# check (and everyone's diffs) agree between Windows and CI. The LFS rules below use
# -text, which overrides this for the binaries they match.
* text=auto eol=lf

*.psd filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.svg filter=lfs diff=lfs merge=lfs -text
zipalign filter=lfs diff=lfs merge=lfs -text
*.ai filter=lfs diff=lfs merge=lfs -text

# Packed weather records. Bytes rather than text, so the eol=lf rule above must not touch them,
# and a diff of one is noise. Not LFS: they are 57KB each and written once, never edited.
*.bin binary
