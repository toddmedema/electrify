rules_version = '2';

// Firestore security rules for electrify-game.
//
// These used to live only in the Firebase console, where a rule change was invisible to reviewers
// and easy to forget before a deploy. They ship from the repo now:
//
//   firebase deploy --only firestore
//
// which has to run BEFORE the client bundle that depends on them, or reads fail closed.
//
// Accepted limitation, unchanged from before: scores are client-authoritative. Rules cannot
// re-run a simulation, so nothing here proves a score was actually earned. If cheating on the
// board becomes a real problem, scoring must move to a trusted server.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The structural half of validateDisplayName in src/helpers/DisplayName.tsx -- length,
    // charset, spacing. Keep the two in sync: the client is what gives a player a useful error
    // message, and this is what makes the constraint true.
    // matches() is anchored to the whole string, so the pattern covers the charset and rules out
    // a leading or trailing space in one go; the second clause rules out doubled spaces.
    // The reserved-name blocklist is deliberately NOT mirrored here. It is a courtesy, not a
    // security boundary, and a list that has to be redeployed to change belongs in the client.
    function isValidDisplayName(name) {
      return name is string
        && name.size() >= 3
        && name.size() <= 20
        && name.matches('[A-Za-z0-9_-][A-Za-z0-9 _-]*[A-Za-z0-9_-]')
        && !name.matches('.*  .*');
    }

    // A player's profile. Public: it holds a leaderboard name and per-scenario bests, nothing
    // private. Only the player themselves may write it.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && (!('displayName' in request.resource.data)
            || isValidDisplayName(request.resource.data.displayName));
      allow delete: if false;

      // BEGIN GENERATED ACHIEVEMENT RULES
      // Private, grow-only account history; generated from the shared catalog.
      match /achievementProgress/{progressId} {
        function validAchievements(data) {
          return progressId == 'current'
            && data.keys().hasAll(['version', 'earned', 'tutorials', 'wins'])
            && data.keys().hasOnly(['version', 'earned', 'tutorials', 'wins'])
            && data.version == 1
            && data.earned is list && data.earned.size() <= 35
            && data.earned.toSet().size() == data.earned.size()
            && data.earned.hasOnly([
            "FIRST_SPARK",
            "GRID_GRADUATE",
            "STAYING_POWER",
            "CHIEF_ELECTRICITY_OFFICER",
            "LIGHTS_ON",
            "FOUR_NINES",
            "BACK_ON_THE_GRID",
            "CLEAN_FINISH",
            "HALF_THE_CARBON",
            "COALS_LAST_SHIFT",
            "HERE_COMES_THE_SUN",
            "WINDS_OF_CHANGE",
            "STRENGTH_IN_DIVERSITY",
            "NIGHT_SHIFT",
            "GRID_CONNECTED",
            "GOOD_NEIGHBOR",
            "WASTE_NOT",
            "A_WATT_SAVED",
            "POWER_TO_THE_PEOPLE",
            "THE_PRICE_OF_CARBON",
            "BOOM_AND_BEYOND",
            "ISLAND_INDEPENDENCE",
            "A_BRIGHTER_FUTURE",
            "WEATHER_THE_STORM",
            "THE_NEXT_ERA",
            "AHEAD_OF_THE_BOOM",
            "COLD_COMFORT",
            "COOL_UNDER_PRESSURE",
            "BACKUP_PLAN",
            "FIREBREAK",
            "THE_END_OF_LOAD_SHEDDING",
            "BEYOND_THE_RIVER",
            "BEAT_THE_HEAT",
            "MASTER_OF_THE_GRID",
            "OUT_OF_JUICE"
          ])
            && data.tutorials is list && data.tutorials.size() <= 7
            && data.tutorials.toSet().size() == data.tutorials.size()
            && data.tutorials.hasOnly([0,1,2,4,3,5,112])
            && data.wins is list && data.wins.size() <= 70
            && data.wins.toSet().size() == data.wins.size()
            && data.wins.hasOnly([
            "100:Intern",
            "100:Employee",
            "100:Manager",
            "100:VP",
            "100:CEO",
            "103:Intern",
            "103:Employee",
            "103:Manager",
            "103:VP",
            "103:CEO",
            "105:Intern",
            "105:Employee",
            "105:Manager",
            "105:VP",
            "105:CEO",
            "101:Intern",
            "101:Employee",
            "101:Manager",
            "101:VP",
            "101:CEO",
            "104:Intern",
            "104:Employee",
            "104:Manager",
            "104:VP",
            "104:CEO",
            "102:Intern",
            "102:Employee",
            "102:Manager",
            "102:VP",
            "102:CEO",
            "106:Intern",
            "106:Employee",
            "106:Manager",
            "106:VP",
            "106:CEO",
            "107:Intern",
            "107:Employee",
            "107:Manager",
            "107:VP",
            "107:CEO",
            "108:Intern",
            "108:Employee",
            "108:Manager",
            "108:VP",
            "108:CEO",
            "110:Intern",
            "110:Employee",
            "110:Manager",
            "110:VP",
            "110:CEO",
            "111:Intern",
            "111:Employee",
            "111:Manager",
            "111:VP",
            "111:CEO",
            "113:Intern",
            "113:Employee",
            "113:Manager",
            "113:VP",
            "113:CEO",
            "114:Intern",
            "114:Employee",
            "114:Manager",
            "114:VP",
            "114:CEO",
            "115:Intern",
            "115:Employee",
            "115:Manager",
            "115:VP",
            "115:CEO"
          ]);
        }
        allow get: if isOwner(uid);
        allow list, delete: if false;
        allow create: if isOwner(uid) && validAchievements(request.resource.data);
        allow update: if isOwner(uid) && validAchievements(request.resource.data)
          && request.resource.data.earned.hasAll(resource.data.earned)
          && request.resource.data.tutorials.hasAll(resource.data.tutorials)
          && request.resource.data.wins.hasAll(resource.data.wins);
      }
      // END GENERATED ACHIEVEMENT RULES

      // Backups are private, including their names, and deletions persist as tombstones.
      match /cloudSaves/{saveId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['version', 'deleted', 'chunks', 'metadata', 'garbage', 'writerDeviceId', 'writerLocalId', 'sourceRevision'])
          && request.resource.data.version is string
          && request.resource.data.version.matches('[a-f0-9]{32}')
          && request.resource.data.deleted is bool
          && request.resource.data.chunks is list
          && request.resource.data.chunks.size() <= 60;
        allow delete: if false;
      }
    }

    function validExpiry(expiry) {
      // A bounded allowance for browser clock skew; the server controls the load timestamp.
      return expiry is timestamp
        && expiry >= request.time + duration.value(365, 'd') - duration.value(5, 'm')
        && expiry <= request.time + duration.value(365, 'd') + duration.value(5, 'm');
    }

    match /sharedGames/{shareId} {
      // No collection listing. Missing-document reads let authenticated creators check collisions.
      allow get: if (resource == null && isSignedIn())
        || (resource != null && resource.data.expiresAt > request.time);
      allow list: if false;
      allow create: if isSignedIn()
        && shareId.matches('[A-Za-z0-9]{10}')
        && request.resource.data.keys().hasOnly(['uid', 'chunks', 'lastLoadedAt', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.chunks is list
        && request.resource.data.chunks.size() > 0
        && request.resource.data.chunks.size() <= 60
        && request.resource.data.lastLoadedAt == request.time
        && validExpiry(request.resource.data.expiresAt);
      // Anyone with the link can refresh retention, but cannot change the frozen payload.
      allow update: if resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoadedAt', 'expiresAt'])
        && request.resource.data.lastLoadedAt == request.time
        && validExpiry(request.resource.data.expiresAt);
      allow delete: if false; // Firestore TTL performs deletion with administrative privileges.
    }

    match /saveBlobs/{blobId} {
      function shared() {
        return get(/databases/$(database)/documents/sharedGames/$(resource.data.shareId));
      }
      allow get: if (resource.data.shareId == null && isOwner(resource.data.uid))
        || (resource.data.shareId != null
          && shared().data.expiresAt > request.time
          && blobId in shared().data.chunks);
      allow list: if false;
      allow create: if isOwner(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid', 'shareId', 'data', 'expiresAt'])
        && blobId.matches('[a-f0-9]{32}')
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 600000
        && ((request.resource.data.shareId == null && request.resource.data.expiresAt == null)
          || (request.resource.data.shareId is string
            && !exists(/databases/$(database)/documents/sharedGames/$(request.resource.data.shareId))
            && getAfter(/databases/$(database)/documents/sharedGames/$(request.resource.data.shareId)).data.uid == request.auth.uid
            && blobId in getAfter(/databases/$(database)/documents/sharedGames/$(request.resource.data.shareId)).data.chunks
            && request.resource.data.expiresAt == getAfter(/databases/$(database)/documents/sharedGames/$(request.resource.data.shareId)).data.expiresAt));
      allow update: if resource.data.shareId != null
        && shared().data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt'])
        && request.resource.data.expiresAt == getAfter(/databases/$(database)/documents/sharedGames/$(resource.data.shareId)).data.expiresAt
        && validExpiry(request.resource.data.expiresAt);
      // Retried cleanup may encounter chunks already removed by another batch/device.
      allow delete: if (resource == null && isSignedIn())
        || (resource.data.shareId == null && isOwner(resource.data.uid));
    }

    // Publicly readable: hiding the board from logged-out players inverts the incentive to sign
    // up, since seeing named strangers above you is the reason to bother.
    match /scores/{scoreId} {
      allow read: if true;
      // Legacy clients retain their historical records; current competitive queries exclude them.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'appVersion', 'scoreVersion', 'outcome', 'scenarioId', 'score',
          'scoreBreakdown', 'difficulty', 'date', 'uid', 'displayName'
        ])
        && (!('scoreVersion' in request.resource.data)
          || (request.resource.data.scoreVersion == 2
            && request.resource.data.outcome == 'completed'
            && request.resource.data.score is number
            && request.resource.data.scoreBreakdown is map
            && request.resource.data.scoreBreakdown.keys().hasAll(['service', 'financial', 'environmental'])
            && request.resource.data.scoreBreakdown.keys().hasOnly(['service', 'financial', 'environmental'])
            && request.resource.data.scoreBreakdown["service"] is number
            && request.resource.data.scoreBreakdown["financial"] is number
            && request.resource.data.scoreBreakdown["environmental"] is number));
      // Renaming backfills the denormalized name onto the player's own old scores, and that is
      // the only field a score may ever change.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow delete: if false;
    }
  }
}
