{
  "name": "electrify",
  "description": "A mobile-friendly web game that teaches about the electricity markets in the style of a Tycoon game. Hosted at https://electrifygame.com",
  "license": "MIT",
  "version": "1.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@reduxjs/toolkit": "^2.12.0",
    "firebase": "^12.18.0",
    "lodash.clonedeep": "^4.5.0",
    "numbro": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys": "^2.0.0",
    "react-redux": "^9.3.0",
    "react-transition-group": "^4.4.5",
    "suncalc": "^2.0.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^27.5.2",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-transition-group": "^4.4.12",
    "prettier": "^3.9.6",
    "react-scripts": "5.0.1",
    "sass": "^1.103.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --coverage --testMatch=\"**/src/**/*.{spec,test}.{js,jsx,ts,tsx}\"",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "sim": "node scripts/sim.js",
    "fetch-weather": "node scripts/fetch-weather.js",
    "update-weather": "node scripts/update-weather.js",
    "fetch-watersheds": "node scripts/fetch-watersheds.js",
    "eject": "react-scripts eject",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,json}\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,scss,json}\" \"scripts/**/*.js\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.js\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.js\" --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:ci && npm run sim -- --all",
    "deploy": "./scripts/deploy.sh"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "@typescript-eslint/no-explicit-any": "error",
      "no-console": [
        "error",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ],
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "args": "after-used",
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrors": "all",
          "caughtErrorsIgnorePattern": "^_"
        }
      ],
      "eqeqeq": [
        "error",
        "always",
        {
          "null": "ignore"
        }
      ],
      "no-var": "error",
      "prefer-const": "error"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">= 24 < 25"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/react-app-env.d.ts",
      "!src/helpers/CustomGameForecastClient.ts",
      "!src/workers/**/*.ts",
      "!src/testing/SimCli.tsx"
    ],
    "coverageThreshold": {
      "src/helpers/": {
        "statements": 85,
        "branches": 75,
        "functions": 80,
        "lines": 85
      },
      "src/reducers/": {
        "statements": 75,
        "branches": 58,
        "functions": 50,
        "lines": 75
      }
    }
  },
  "overrides": {
    "@tootallnate/once": "^2.0.1",
    "bfj": "^9.1.3",
    "fast-uri": "^3.1.6",
    "qs": "^6.16.0",
    "serialize-javascript": "^7.0.3",
    "@svgr/plugin-svgo": {
      "svgo": "^2.8.3"
    },
    "react-scripts": {
      "resolve-url-loader": "5.0.0",
      "typescript": "$typescript",
      "webpack-dev-server": "^5.2.6"
    },
    "uuid": "^11.1.1"
  }
}
