{
  "name": "electrify",
  "description": "A mobile-friendly web game that teaches about the electricity markets in the style of a Tycoon game. Hosted at https://electrifygame.com",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@reduxjs/toolkit": "^2.12.0",
    "async": "^3.2.6",
    "firebase": "^12.18.0",
    "lodash.clonedeep": "^4.5.0",
    "numbro": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys": "^2.0.0",
    "react-joyride": "^3.2.0",
    "react-redux": "^9.3.0",
    "react-transition-group": "^4.4.5",
    "redux": "^5.0.1",
    "suncalc": "^2.0.1",
    "uplot": "^1.6.32",
    "web-vitals": "^6.1.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/async": "^3.2.25",
    "@types/jest": "^30.0.0",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-transition-group": "^4.4.12",
    "prettier": "^3.9.6",
    "react-scripts": "5.0.1",
    "sass": "^1.103.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "sim": "node scripts/sim.js",
    "fetch-weather": "node scripts/fetch-weather.js",
    "fetch-watersheds": "node scripts/fetch-watersheds.js",
    "eject": "react-scripts eject",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,scss,json}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test -- --watchAll=false",
    "deploy": "./deploy.sh"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "@typescript-eslint/no-explicit-any": "error",
      "no-console": [
        "error",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ],
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "args": "after-used",
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrors": "all",
          "caughtErrorsIgnorePattern": "^_"
        }
      ],
      "eqeqeq": [
        "error",
        "always",
        {
          "null": "ignore"
        }
      ],
      "no-var": "error",
      "prefer-const": "error"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">= 24 < 25"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/react-app-env.d.ts",
      "!src/testing/SimCli.tsx"
    ],
    "coverageThreshold": {
      "src/helpers/": {
        "statements": 85,
        "branches": 75,
        "functions": 80,
        "lines": 85
      },
      "src/reducers/": {
        "statements": 75,
        "branches": 58,
        "functions": 50,
        "lines": 75
      }
    }
  },
  "overrides": {
    "react-scripts": {
      "typescript": "$typescript"
    }
  }
}
