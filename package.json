{
  "name": "electrify",
  "description": "A mobile-friendly web game that teaches about the electricity markets in the style of a Tycoon game. Hosted at https://electrifygame.com",
  "license": "SEE LICENSE IN LICENSE.md",
  "version": "1.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@reduxjs/toolkit": "^2.12.0",
    "firebase": "^12.18.0",
    "koffi": "3.3.3",
    "lodash.clonedeep": "^4.5.0",
    "numbro": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-transition-group": "^4.4.5",
    "steamworks.js": "0.4.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^27.5.2",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-transition-group": "^4.4.12",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "15.32.1",
    "prettier": "^3.9.6",
    "react-scripts": "5.0.1",
    "sass": "^1.103.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "node scripts/dev/run.js start",
    "build": "node scripts/dev/run.js build",
    "test": "node scripts/dev/run.js jest test",
    "test:once": "node scripts/dev/run.js jest test --watchAll=false",
    "test:ci": "node scripts/dev/run.js jest test --watchAll=false --coverage --testMatch=\"**/src/**/*.{spec,test}.{js,jsx,ts,tsx}\" --testPathIgnorePatterns=/node_modules/ --testPathIgnorePatterns=\"\\.sim\\.test\\.\"",
    "test:sim": "node scripts/dev/run.js jest test --watchAll=false --testMatch=\"**/src/**/*.sim.test.{ts,tsx}\"",
    "test:ci-tools": "node --test scripts/ci/*.test.js",
    "test:ci-all": "node scripts/dev/run.js ci-tests",
    "test:ci-coverage": "node scripts/ci/coverage.js test-results 1",
    "test:e2e": "node scripts/dev/run.js playwright test --config e2e/playwright.config.ts",
    "test:e2e:ci": "node scripts/dev/run.js playwright test --config e2e/ci.playwright.config.ts",
    "test:e2e:production": "node scripts/dev/run.js playwright test --config e2e/production.playwright.config.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-electrify-achievements \"node --test firebase/achievements.test.cjs\"",
    "sim": "node scripts/dev/run.js sim",
    "mods:arcs": "node scripts/mods-arcs.js",
    "premods:arcs": "npm run compatibility:generate",
    "perf:bench": "node scripts/dev/run.js bench",
    "perf:bundle": "node scripts/perf/bundle-size.js",
    "perf:rebaseline": "node scripts/perf/rebaseline.js",
    "fetch-weather": "node scripts/fetch-weather.js",
    "update-weather": "node scripts/update-weather.js",
    "fetch-watersheds": "node scripts/fetch-watersheds.js",
    "eject": "react-scripts eject",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,json}\" \"scripts/**/*.js\" \"e2e/**/*.ts\" \"electron/**/*.cjs\" \"firebase/functions/**/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,scss,json}\" \"scripts/**/*.js\" \"e2e/**/*.ts\" \"electron/**/*.cjs\" \"firebase/functions/**/*.cjs\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.js\" \"electron/**/*.cjs\" \"firebase/functions/**/*.cjs\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.js\" \"electron/**/*.cjs\" \"firebase/functions/**/*.cjs\" --fix",
    "typecheck": "node scripts/dev/run.js types",
    "check": "node scripts/dev/run.js check",
    "check:ci": "node scripts/dev/run.js check --ci",
    "task": "node scripts/dev/task.js",
    "ci:failures": "node scripts/ci/failures.js",
    "ci:history": "node scripts/ci/failures.js --history",
    "check:assets": "node scripts/check-assets.js",
    "fix": "npm run lint:fix && npm run format",
    "deploy": "./scripts/deploy.sh",
    "compatibility:generate": "node scripts/run-compatibility.js",
    "icons:generate": "node scripts/generate-icon-manifest.js",
    "achievements:artwork": "node steamworks/achievement-artwork/export.cjs",
    "desktop:build": "node scripts/dev/run.js desktop-build",
    "desktop:start": "electron .",
    "desktop:pack": "node scripts/desktop-package.js --mode steam",
    "desktop:pack:offline": "node scripts/desktop-package.js --mode offline",
    "desktop:verify": "node scripts/desktop-verify.js",
    "test:desktop:native": "node --test electron/*.test.cjs",
    "test:desktop": "playwright test --config e2e/desktop.playwright.config.ts",
    "test:multiplayer": "node scripts/dev/run.js playwright test --config e2e/multiplayer.playwright.config.ts",
    "mods:validate": "node scripts/mods-validate.js",
    "premods:validate": "npm run compatibility:generate",
    "mods:schema": "node scripts/mods-schema.js",
    "mods:recipes": "node scripts/mods-recipes.js",
    "test:steam-input": "node scripts/dev/run.js playwright test --config e2e/steam-input.playwright.config.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "@typescript-eslint/no-explicit-any": "error",
      "no-console": [
        "error",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ],
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "args": "after-used",
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrors": "all",
          "caughtErrorsIgnorePattern": "^_"
        }
      ],
      "eqeqeq": [
        "error",
        "always",
        {
          "null": "ignore"
        }
      ],
      "no-var": "error",
      "prefer-const": "error"
    },
    "overrides": [
      {
        "files": [
          "src/data/**",
          "src/helpers/**",
          "src/reducers/**",
          "src/SaveGame.tsx",
          "src/testing/**",
          "src/workers/**"
        ],
        "excludedFiles": [
          "*.test.*",
          "*.spec.*"
        ],
        "rules": {
          "no-restricted-properties": [
            "error",
            {
              "object": "Math",
              "property": "pow",
              "message": "Math.pow's last bit depends on the platform's C library. Use pow from helpers/Pow so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "exp",
              "message": "Math.exp rounds differently on arm64 than on x86-64. Use exp from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "expm1",
              "message": "Math.expm1 rounds differently on arm64 than on x86-64. Use expm1 from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "log",
              "message": "Math.log rounds differently on arm64 than on x86-64. Use log from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "log1p",
              "message": "Math.log1p rounds differently on arm64 than on x86-64. Use log1p from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "log2",
              "message": "Math.log2 rounds differently on arm64 than on x86-64. Use log2 from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "log10",
              "message": "Math.log10 rounds differently on arm64 than on x86-64. Use log10 from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "sin",
              "message": "Math.sin rounds differently on arm64 than on x86-64. Use sin from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "cos",
              "message": "Math.cos rounds differently on arm64 than on x86-64. Use cos from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "tan",
              "message": "Math.tan rounds differently on arm64 than on x86-64. Use tan from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "asin",
              "message": "Math.asin rounds differently on arm64 than on x86-64. Use asin from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "acos",
              "message": "Math.acos rounds differently on arm64 than on x86-64. Use acos from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "atan",
              "message": "Math.atan rounds differently on arm64 than on x86-64. Use atan from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "atan2",
              "message": "Math.atan2 rounds differently on arm64 than on x86-64. Use atan2 from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "sinh",
              "message": "Math.sinh rounds differently on arm64 than on x86-64. Use sinh from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "cosh",
              "message": "Math.cosh rounds differently on arm64 than on x86-64. Use cosh from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "tanh",
              "message": "Math.tanh rounds differently on arm64 than on x86-64. Use tanh from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "asinh",
              "message": "Math.asinh rounds differently on arm64 than on x86-64. Use asinh from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "acosh",
              "message": "Math.acosh rounds differently on arm64 than on x86-64. Use acosh from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "atanh",
              "message": "Math.atanh rounds differently on arm64 than on x86-64. Use atanh from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "cbrt",
              "message": "Math.cbrt rounds differently on arm64 than on x86-64. Use cbrt from helpers/Libm so simulations produce identical results everywhere."
            },
            {
              "object": "Math",
              "property": "random",
              "message": "Use addressed draws from helpers/Math with the stored seed. Ambient randomness breaks saved-run determinism."
            },
            {
              "object": "globalThis",
              "property": "Math",
              "message": "Use Math directly so the deterministic-math restrictions apply to its methods."
            },
            {
              "object": "window",
              "property": "Math",
              "message": "Use Math directly so the deterministic-math restrictions apply to its methods."
            },
            {
              "object": "self",
              "property": "Math",
              "message": "Use Math directly so the deterministic-math restrictions apply to its methods."
            },
            {
              "object": "global",
              "property": "Math",
              "message": "Use Math directly so the deterministic-math restrictions apply to its methods."
            }
          ],
          "no-restricted-syntax": [
            "error",
            {
              "selector": "BinaryExpression[operator='**']:not([right.type='Literal'][right.value=2]):not([left.type='Literal'][left.value=2][right.type='Literal'][right.raw=/^[0-9_]+$/]):not([left.type='Literal'][left.value=2][right.type='UnaryExpression'][right.operator=/^[+-]$/][right.argument.type='Literal'][right.argument.raw=/^[0-9_]+$/]), AssignmentExpression[operator='**=']",
              "message": "Only squares and literal integer powers of two may use **. Use pow from helpers/Pow for other exponents so simulations produce identical results everywhere."
            }
          ]
        }
      },
      {
        "files": [
          "electron/**/*.cjs",
          "firebase/functions/**/*.cjs"
        ],
        "env": {
          "node": true,
          "es2020": true
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">= 24 < 25"
  },
  "jest": {
    "extraGlobals": [
      "Math",
      "Number",
      "Object",
      "Array",
      "JSON",
      "BigInt"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/testing/SimulationTestHelpers.ts",
      "!src/**/*.d.ts",
      "!src/helpers/CustomGameForecastClient.ts",
      "!src/helpers/DataCenterSetupClient.ts",
      "!src/helpers/PolicyPreviewClient.ts",
      "!src/helpers/ScenarioStartingPeakClient.ts",
      "!src/components/base/ProjectionWorkerClient.ts",
      "!src/components/base/OutlookWorkerClient.ts",
      "!src/multiplayer/WorkerClient.ts",
      "!src/workers/**/*.ts",
      "!src/testing/SimCli.tsx"
    ],
    "coverageThreshold": {
      "src/helpers/": {
        "statements": 85,
        "branches": 75,
        "functions": 80,
        "lines": 85
      },
      "src/reducers/": {
        "statements": 75,
        "branches": 58,
        "functions": 50,
        "lines": 75
      }
    }
  },
  "overrides": {
    "@tootallnate/once": "^2.0.1",
    "bfj": "^9.1.3",
    "fast-uri": "^3.1.6",
    "qs": "^6.17.0",
    "serialize-javascript": "^7.0.3",
    "svgo": "^2.8.4",
    "react-scripts": {
      "resolve-url-loader": "5.0.0",
      "typescript": "$typescript",
      "webpack-dev-server": "^5.2.6"
    },
    "uuid": "^11.1.1"
  },
  "main": "electron/main.cjs",
  "prettier": {
    "trailingComma": "all",
    "endOfLine": "lf"
  }
}
